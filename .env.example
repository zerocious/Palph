# Telegram-бот
BOT_TOKEN=your-telegram-bot-token-here
MAIN_ADMIN_ID=123456789

# Часовой пояс сервера (используется как fallback; пользовательский TZ в settings)
SERVER_TIMEZONE=Europe/Moscow

# --- ADD THESE ON BOTHOST (Pro panel → Environment) -------------------------
# Без них бот сам подставит /app/data/*, если видит Docker/bothost layout.
# Явно задайте, если хотите контроль или bothost не монтирует /app/data:
#   DB_PATH=/app/data/studybuddy.db
#   LOG_FILE=/app/data/bot.log
#   BACKUP_DIR=/app/data/backups
# ---------------------------------------------------------------------------
#
# Пути к persistent state.
# Локально (без Docker) — рядом с bot.py (значения ниже).
# Docker / bothost.ru — persistent storage в /app/data/ (авто, если /app/data
# существует или код лежит в /app/bot.py).
# На bothost.ru бесплатный тариф может сбрасывать данные при redeploy;
# платный тариф сохраняет /app/data между рестартами.
DB_PATH=studybuddy.db
LOG_FILE=bot.log

# Backup системы. Snapshot БД создаётся раз в день после streak processing.
# /backup admin-команда делает manual snapshot в любой момент.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Логи. DEBUG/INFO/WARNING/ERROR. По умолчанию INFO.
LOG_LEVEL=INFO
