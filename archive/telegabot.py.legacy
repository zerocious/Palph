@router.message(F.text.in_(["Раздел I", "Раздел II", "Раздел III", "Раздел IV"]))
async def handle_quiz_section(message: Message, state: FSMContext):
    section_map = {
        "Раздел I": "i",
        "Раздел II": "ii",
        "Раздел III": "iii",
        "Раздел IV": "iv"
    }
    
    section_key = section_map.get(message.text)
    
    # Обработка разделов с вопросами/практикой
    if message.text in ["Вопросы к экзамену", "Практика к экзамену"]:
        await message.answer("🛠️ Этот раздел пока в разработке. Скоро появится!", reply_markup=get_quiz_section_keyboard())
        return
    
    if not section_key:
        await message.answer("⚠️ Неизвестный раздел", reply_markup=get_quiz_section_keyboard())
        return
    
    # Загружаем термины раздела
    terms = load_quiz_section(section_key)
    if not terms:
        await message.answer(
            f"❌ Файл раздела {message.text} не найден или пуст.\n"
            f"Проверьте наличие файла: `quizzes/production-management/section-{section_key}.txt`",
            reply_markup=get_quiz_section_keyboard()
        )
        return
    
    # Находим следующий термин для повторения
    user_id = str(message.from_user.id)
    next_term = get_next_quiz_term(user_id, terms)
    
    if not next_term:
        await message.answer(
            "🎉 Ты повторил все термины этого раздела! Отличная работа! 🏆",
            reply_markup=get_quiz_section_keyboard()
        )
        return
    
    # Сохраняем текущий термин в состоянии
    await state.update_data(
        current_term=next_term.to_dict(),
        section=section_key,
        section_name=message.text
    )
    
    # Задаём вопрос
    await message.answer(
        f"✏️ Раздел: {message.text}\n\n"
        f"Напиши ДОСЛОВНОЕ определение термина:\n"
        f"«{next_term.term}»\n\n"
        f"❗ На экзамене требуется точная формулировка.",
        reply_markup=get_quiz_answer_keyboard()
    )
    await state.set_state(QuizStates.answering)

@router.message(QuizStates.answering, F.text == "🛑 Завершить квиз")
async def handle_quiz_exit(message: Message, state: FSMContext):
    await state.clear()
    await message.answer("✅ Квиз завершён. Твой прогресс сохранён!", reply_markup=get_study_keyboard())

@router.message(QuizStates.answering)
async def handle_quiz_answer(message: Message, state: FSMContext):
    data = await state.get_data()
    current_term = data.get("current_term")
    
    if not current_term:
        await message.answer("⚠️ Ошибка: термин не найден. Начни квиз заново.", reply_markup=get_quiz_section_keyboard())
        await state.clear()
        return
    
    # Проверяем ответ
    is_correct, feedback = check_text_answer(
        message.text,
        current_term["definition"],
        current_term["keywords"]
    )
    
    # Обновляем прогресс
    user_id = str(message.from_user.id)
    progress = get_quiz_progress(user_id, current_term["hash"])
    streak = progress.get("streak", 0)
    
    if is_correct:
        streak += 1
        feedback = f"{feedback}\n\n🔥 Отлично! Термин будет повторён через {2 ** min(streak, 3)} дня для закрепления."
    else:
        streak = 0
    
    update_quiz_progress(user_id, current_term["hash"], is_correct, streak)
    
    # Отправляем обратную связь
    await message.answer(feedback)
    await asyncio.sleep(1.5)
    
    # Предлагаем следующий термин
    terms = load_quiz_section(data["section"])
    next_term = get_next_quiz_term(user_id, terms)
    
    if next_term:
        await state.update_data(
            current_term=next_term.to_dict(),
            section=data["section"],
            section_name=data["section_name"]
        )
        await message.answer(
            f"✏️ Раздел: {data['section_name']}\n\n"
            f"Напиши ДОСЛОВНОЕ определение термина:\n"
            f"«{next_term.term}»",
            reply_markup=get_quiz_answer_keyboard()
        )
    else:
        await message.answer(
            "🎉 Все термины раздела повторены! Ты молодец!",
            reply_markup=get_quiz_section_keyboard()
        )
        await state.clear()


# Команда /reply (только для админов)
@router.message(Command("reply"))
async def cmd_reply(message: Message, command: CommandObject):
    if not is_admin(message.from_user.id):
        await message.answer("❌ У вас нет прав для ответа пользователям.")
        return
    
    args = command.args
    if not args or len(args.split(maxsplit=1)) < 2:
        await message.answer(
            "❌ Использование: /reply <user_id> <сообщение>\n"
            "Пример: /reply 123456789 Спасибо за вопрос!"
        )
        return
    
    user_id_str, reply_text = args.split(maxsplit=1)
    
    try:
        user_id = int(user_id_str)
        await bot.send_message(user_id, f"📨 Ответ от администратора:\n\n{reply_text}")
        await message.answer(f"✅ Ответ отправлен пользователю {user_id}")
        
    except ValueError:
        await message.answer("❌ Неверный формат ID. Введите числовой ID.")
    except Exception as e:
        await message.answer(f"❌ Ошибка отправки: {str(e)}")

# Обработка всех остальных сообщений (для пользователей)
@router.message()
async def handle_any_message(message: Message):
    user_id = message.from_user.id
    
    # Если сообщение от админа — даём подсказку
    if is_admin(user_id):
        await message.answer(" Используйте команду /reply <user_id> <сообщение> для ответа пользователям.")
        return
    
    # Сохраняем сообщение для админов
    user_name = f"{message.from_user.first_name} {message.from_user.last_name or ''}".strip()
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    # Сохраняем в файл
    if str(user_id) not in messages_data["user_messages"]:
        messages_data["user_messages"][str(user_id)] = []
    
    messages_data["user_messages"][str(user_id)].append({
        "timestamp": timestamp,
        "user_name": user_name,
        "text": message.text,
        "message_id": message.message_id
    })
    
    # Сохраняем файл с кодировкой UTF-8
    try:
        with open(MESSAGES_FILE, 'w', encoding='utf-8') as f:
            json.dump(messages_data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения сообщений: {e}")
    
    # Отправляем админам
    admin_msg = (
        f"📩 Новое сообщение:\n"
        f"👤 {user_name} (ID: {user_id})\n"
        f"⏰ {timestamp}\n"
        f"📝 {message.text}"
    )
    
    for admin_id in ADMINS:
        try:
            await bot.send_message(admin_id, admin_msg)
        except Exception as e:
            logger.error(f"Не удалось отправить админу {admin_id}: {e}")
    
    await message.answer(
        "✅ Твое сообщение отправлено! Администратор ответит в ближайшее время.\n\n"
        "А пока можешь продолжить учиться — выбери Учеба в меню ниже 👇",
        reply_markup=get_main_keyboard()
    )

async def check_daily_streaks():
    """
    ОДНОКРАТНАЯ проверка стриков ВСЕХ пользователей в 23:59 по МСК.
    Вызывается фоновой задачей ТОЛЬКО один раз в сутки.
    """
    moscow_tz = pytz.timezone('Europe/Moscow')
    now = datetime.now(moscow_tz)
    
    # Логируем для отладки
    logger.info(f"🌙 Запуск проверки стриков. Время МСК: {now.strftime('%Y-%m-%d %H:%M')}")
    
    try:
        sheet = get_sheet()
        all_users = sheet.get_all_records()
        processed = 0
        bonuses = 0
        
        for user in all_users:
            user_id = user.get("user_id", "")
            if not user_id:
                continue
            
            # Запускаем синхронную функцию в отдельном потоке
            result = await asyncio.to_thread(update_daily_streak, user_id)
            
            if result["success"]:
                processed += 1
                bonuses += result["bonus"]
                
                # Отправляем уведомление при бонусе
                if result["bonus"] > 0:
                    try:
                        await bot.send_message(
                            int(user_id),
                            f"🌙 Добрый вечер! Твой стрик обновлён:\n"
                            f"🔥 {result['streak']} дней подряд\n"
                            f"🪙 +{result['bonus']} монет за упорство!"
                        )
                    except:
                        pass
        
        logger.info(f"✅ Стрики обработаны: {processed}/{len(all_users)} пользователей, +{bonuses} монет")
        
    except Exception as e:
        logger.error(f"❌ Ошибка при проверке стриков: {e}")



async def streak_checker_task():
    """
    Фоновый планировщик. Проверяет время КАЖДУЮ МИНУТУ и запускает 
    check_daily_streaks() ТОЛЬКО один раз в 23:59.
    """
    moscow_tz = pytz.timezone('Europe/Moscow')
    last_check_date = None  # Запоминаем дату последней проверки
    
    while True:
        now = datetime.now(moscow_tz)
        today = now.strftime("%Y-%m-%d")
        
        # Запускаем ТОЛЬКО один раз в день в 23:59
        if now.hour == 23 and now.minute == 59 and last_check_date != today:
            await check_daily_streaks()
            last_check_date = today  # Отмечаем, что проверка сегодня выполнена
        
        # Спим 60 секунд ДО СЛЕДУЮЩЕЙ ПРОВЕРКИ ВРЕМЕНИ
        await asyncio.sleep(60)

def get_timezone_name(timezone_str):
    """Преобразует UTC+3 в название часового пояса"""
    tz_map = {
        "UTC+3": "Europe/Moscow",
        "UTC+2": "Europe/Kiev",
        "UTC+4": "Europe/Samara",
        "UTC+7": "Asia/Novosibirsk"
    }
    return tz_map.get(timezone_str, "UTC")



# Запуск фоновой задачи
@dp.startup()
async def on_startup():
    asyncio.create_task(streak_checker_task())
    logger.info("✅ Фоновая задача для проверки стриков запущена")
    
    # Проверяем подключение к Google Sheets
    try:
        test_sheet = get_sheet()
        logger.info(f"✅ Подключение к Google Таблице 'palph' успешно")
    except Exception as e:
        logger.error(f"❌ Не удалось подключиться к Google Таблице: {e}")
        logger.error(f"🔧 Проверьте:")
        logger.error(f"  • Файл {GOOGLE_CREDS_PATH} существует")
        logger.error(f"  • GOOGLE_SHEET_URL в .env корректен: {GOOGLE_SHEET_URL}")
        logger.error(f"  • Сервисному аккаунту даны права на редактирование таблицы")
        # Не выходим, чтобы бот продолжал работать с базовой функциональностью



# Основной запуск
async def main():
    logger.info("✅ StudyBuddy Bot запускается...")
    logger.info(f"🌍 Часовой пояс сервера: {SERVER_TIMEZONE}")
    logger.info(f"👑 Главный админ: {MAIN_ADMIN_ID}")
    logger.info(f"📁 Google Таблица: palph")
    logger.info(f"🔐 Файл сервисного аккаунта: {GOOGLE_CREDS_PATH}")
    
    # Регистрация роутеров
    dp.include_router(router)
    
    # Запускаем бота
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
