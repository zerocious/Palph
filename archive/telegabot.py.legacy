# === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ КВИЗОВ ===
QUIZZES_PATH = "quizzes/production-management"

class QuizTerm:
    """Модель термина для квиза"""
    def __init__(self, term: str, definition: str, keywords: str, situation: str):
        self.term = term
        self.definition = definition
        self.keywords = [kw.strip() for kw in keywords.split(",")]
        self.situation = situation
        self.hash = hashlib.md5(term.encode('utf-8')).hexdigest()[:8]
    
    def to_dict(self):
        return {
            "term": self.term,
            "definition": self.definition,
            "keywords": self.keywords,
            "situation": self.situation,
            "hash": self.hash
        }

def load_quiz_section(section: str) -> list:
    """Загружает термины из файла раздела"""
    file_path = os.path.join(QUIZZES_PATH, f"section-{section.lower()}.txt")
    
    if not os.path.exists(file_path):
        logger.error(f"Файл квиза не найден: {file_path}")
        return []
    
    terms = []
    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            
            parts = [p.strip() for p in line.split('||')]
            if len(parts) == 4:
                term, definition, keywords, situation = parts
                terms.append(QuizTerm(term, definition, keywords, situation))
    
    return terms


def add_user_with_settings(user_id, settings=None):
    sheet = get_sheet()
    
    # Дефолтные настройки
    if settings is None:
        settings = {
            "notification_time_morning": "09:00",
            "notification_time_evening": "21:00",
            "notification_streak": True,
            "notification_morning_enabled": True,
            "notification_evening_enabled": True,
            "notification_achievements_enabled": True,  # ← ВКЛЮЧЕНО ПО УМОЛЧАНИЮ
            "timezone": "Europe/Moscow"
        }
    
    # Преобразуем настройки в JSON
    settings_json = json.dumps(settings, ensure_ascii=False)
    
    # Добавляем пользователя с 11 колонками
    sheet.append_row([
        str(user_id),    # A: user_id
        settings["timezone"],  # B: timezone
        "FALSE",         # C: has_studied
        "",              # D: last_reminder
        "TRUE",          # E: reminder_active
        "0",             # F: total_sessions
        "0",             # G: total_coins
        "",              # H: last_session
        "0",             # I: current_streak
        "{}",            # J: achievements
        settings_json    # K: notification_settings
    ])

    
def check_text_answer(user_answer: str, correct_definition: str, keywords: list) -> tuple:
    """
    Умная проверка дословного определения для экзамена
    
    Возвращает: (правильно_ли, сообщение_обратной_связи)
    """
    # Нормализация текста (удаляем знаки препинания, приводим к нижнему регистру)
    user_norm = re.sub(r'[^\w\s]', ' ', user_answer.lower()).strip()
    correct_norm = re.sub(r'[^\w\s]', ' ', correct_definition.lower()).strip()
    
    # Разбиваем на слова
    user_words = user_norm.split()
    correct_words = correct_norm.split()
    
    # Проверка 1: ключевые слова (минимум 2 из списка)
    keyword_matches = sum(1 for kw in keywords if any(kw.lower() in uw for uw in user_words))
    
    if keyword_matches < 2:
        missing = [kw for kw in keywords if not any(kw.lower() in uw for uw in user_words)][:2]
        hint = f"❌ Не хватает ключевых слов: «{'», «'.join(missing)}»"
        return False, hint
    
    # Проверка 2: семантическая близость (≥80% совпадения уникальных слов)
    user_unique = set(user_words)
    correct_unique = set(correct_words)
    common = user_unique & correct_unique
    similarity = len(common) / max(len(correct_unique), 1)
    
    if similarity >= 0.80:
        if similarity >= 0.95:
            return True, "✅ Точно! Дословное определение усвоено."
        else:
            return True, f"✅ Верно! Точная формулировка:\n«{correct_definition}»"
    else:
        # Подсчитываем пропущенные важные слова
        missing_words = correct_unique - user_unique
        if len(missing_words) <= 2:
            hint = f"💡 Почти! Добавь слова: «{'», «'.join(list(missing_words)[:2])}»"
        else:
            hint = "💡 Почти! Сравни со стандартной формулировкой:"
        return False, f"{hint}\n\n📖 Правильное определение:\n«{correct_definition}»"



