# === ОБРАБОТЧИКИ ===
@router.callback_query(F.data.startswith("back_to_profile:"))
async def back_to_profile(callback: CallbackQuery):  
    await callback.answer() 
    
    user_id = callback.data.split(":")[1]
    user = get_user_data(user_id)
    
    if not user:
        await callback.message.answer("❌ Пользователь не найден")
        return
    

    inline_kb = InlineKeyboardBuilder()
    inline_kb.button(text="🏆 Достижения", callback_data=f"show_achievements:{user_id}:1")
    inline_kb.button(text="📅 Задачи", callback_data="daily_tasks")
    inline_kb.button(text="⚙️ Настройки", callback_data=f"settings_menu:{user_id}")
    inline_kb.adjust(2, 1)
    
    try:
        await callback.message.edit_text(
            f"📊 Твой профиль:\n"
            f"🆔 ID: {user_id}\n"
            f"📚 Всего сессий: {user.get('total_sessions', 0)}\n"
            f"💰 Всего монет: {user.get('total_coins', 0)} 🪙\n"
            f"🔥 Стрик: {user.get('current_streak', 0)} дней\n"
            f"⏱️ Последняя сессия: {user.get('last_session', 'никогда')}\n\n"
            f"🐾 Твой питомец: {get_pet_emotion(user.get('current_streak', 0))}",
            reply_markup=inline_kb.as_markup()
        )
    except Exception as e:
        logger.error(f"Ошибка редактирования сообщения профиля: {e}")
        await callback.message.answer(
            f"📊 Твой профиль:\n"
            f"🆔 ID: {user_id}\n"
            f"📚 Всего сессий: {user.get('total_sessions', 0)}\n"
            f"💰 Всего монет: {user.get('total_coins', 0)} 🪙\n"
            f"🔥 Стрик: {user.get('current_streak', 0)} дней\n"
            f"⏱️ Последняя сессия: {user.get('last_session', 'никогда')}\n\n"
            f"🐾 Твой питомец: {get_pet_emotion(user.get('current_streak', 0))}",
            reply_markup=inline_kb.as_markup()
        )
        
# Обработчик меню настроек
@router.callback_query(F.data.startswith("settings_menu:"))
async def show_settings_menu(callback: types.CallbackQuery):
    await callback.answer()
    user_id = callback.data.split(":")[1]
    
    # Защита от пересылки: работаем только со своим профилем
    if user_id != str(callback.from_user.id):
        user_id = str(callback.from_user.id)
        logger.warning(f"Пользователь {user_id} пытался изменить чужой профиль, перенаправлен на свой")
    
    try:
        settings = NotificationSettings(user_id)
        await callback.message.edit_text(
            settings.get_display_text(),
            reply_markup=settings.get_keyboard()
        )
    except Exception as e:
        logger.error(f"Ошибка загрузки настроек для {user_id}: {e}")
        await callback.message.answer(f"❌ Ошибка загрузки настроек: {str(e)}")

# Обработчик переключения настроек
@router.callback_query(F.data.startswith("settings_toggle:"))
async def toggle_notification_setting(callback: types.CallbackQuery):
    await callback.answer()
    
    try:
        parts = callback.data.split(":")
        if len(parts) < 3:
            raise ValueError("Неверный формат колбэка")
        
        setting_type, requested_user_id = parts[1], parts[2]
        actual_user_id = str(callback.from_user.id)
        
        # Защита от пересылки
        user_id = actual_user_id if requested_user_id != actual_user_id else requested_user_id
        
        settings = NotificationSettings(user_id)
        new_value, status_text = settings.toggle(setting_type)
        
        # Обновляем меню
        await callback.message.edit_text(
            settings.get_display_text(),
            reply_markup=settings.get_keyboard()
        )
        
    except Exception as e:
        logger.error(f"Ошибка переключения настройки: {e}")
        await callback.message.answer(f"❌ Ошибка: {str(e)}")
    
# Кнопка "Назад в меню" во время таймера
@router.message(TimerStates.active, F.text == "⬅️ Назад в меню")
async def handle_back_to_menu_during_timer(message: Message, state: FSMContext):
    await message.answer(
        "🐾 Ты вернулся в главное меню.\n"
        "Таймер продолжает работать в фоне — сессия завершится автоматически.\n\n",
