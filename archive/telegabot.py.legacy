class NotificationSettings:
    """Управление настройками уведомлений через декларативный конфиг"""
    
    def __init__(self, user_id: str):
        self.user_id = str(user_id)
        self.sheet = get_sheet()
        self.cell = self._find_user_cell()
        self.settings = self._load_settings()
    
    def _find_user_cell(self):
        """Многоуровневый поиск пользователя в таблице"""
        # Попытка 1: поиск по строке
        try:
            return self.sheet.find(self.user_id, in_column=1)
        except:
            pass
        
        # Попытка 2: поиск по числу
        try:
            return self.sheet.find(int(self.user_id), in_column=1)
        except:
            pass
        
        # Попытка 3: ручной поиск с очисткой пробелов
        all_values = self.sheet.col_values(1)
        for idx, value in enumerate(all_values, start=1):
            if str(value).strip() == self.user_id.strip():
                return type('obj', (object,), {'row': idx})()
        
        # Создаём пользователя, если не найден
        if not user_exists(self.user_id):
            add_user(self.user_id)
            try:
                return self.sheet.find(self.user_id, in_column=1)
            except:
                raise ValueError(f"Не удалось создать/найти пользователя {self.user_id}")
        
        raise ValueError(f"Пользователь {self.user_id} не найден в таблице")
    
    def _load_settings(self):
        """Загрузка или инициализация настроек из колонки K"""
        row = self.sheet.row_values(self.cell.row)
        raw = row[10] if len(row) > 10 else ""
        
        try:
            settings = json.loads(raw) if raw else {}
        except:
            settings = {}
        
        # Инициализация дефолтами из конфига
        for cfg in NOTIFICATION_CONFIG.values():
            if cfg["key"] not in settings:
                settings[cfg["key"]] = True
            if cfg["time_key"] and cfg["time_key"] not in settings:
                settings[cfg["time_key"]] = cfg["default_time"]
        
        settings.setdefault("timezone", "Europe/Moscow")
        return settings
    
    def toggle(self, setting_type: str) -> tuple[bool, str]:
        """Переключение настройки + возврат статуса"""
        cfg = NOTIFICATION_CONFIG.get(setting_type)
        if not cfg:
            raise ValueError(f"Неизвестный тип настройки: {setting_type}")
        
        key = cfg["key"]
        current = self.settings.get(key, True)
        new_value = not current
        self.settings[key] = new_value
        
        # Сохранение в таблицу (колонка K = индекс 11)
        self.sheet.update_cell(self.cell.row, 11, json.dumps(self.settings, ensure_ascii=False))
        
        status = "включены" if new_value else "отключены"
        return new_value, f"{cfg['label']}: {status}"
    
    def get_display_text(self) -> str:
        """Генерация текста меню настроек"""
        lines = ["⚙️ Настройки уведомлений\n"]
        
        for name, cfg in NOTIFICATION_CONFIG.items():
            enabled = self.settings.get(cfg["key"], True)
            time_val = self.settings.get(cfg["time_key"], cfg["default_time"]) if cfg["time_key"] else None
            
            emoji = cfg["emoji_on"] if enabled else cfg["emoji_off"]
            time_str = f" ({time_val})" if time_val else ""
            status = "✅ Включено" if enabled else "❌ Отключено"
            
            lines.append(f"{emoji} {cfg['label']}{time_str}: {status}")
        
        lines.append("\n🇷🇺 Часовой пояс: Москва (UTC+3)")
        return "\n".join(lines)
    
    def get_keyboard(self) -> InlineKeyboardMarkup:
        """Генерация клавиатуры из конфига"""
        kb = InlineKeyboardBuilder()
        
        for name, cfg in NOTIFICATION_CONFIG.items():
            enabled = self.settings.get(cfg["key"], True)
            btn_text = f"{cfg['label']}: {'Выкл' if enabled else 'Вкл'}"
            kb.button(text=btn_text, callback_data=f"settings_toggle:{name}:{self.user_id}")
        
        kb.button(text="⬅️ Назад в профиль", callback_data=f"back_to_profile:{self.user_id}")
        kb.adjust(2, 2, 1)
        return kb.as_markup()
    
