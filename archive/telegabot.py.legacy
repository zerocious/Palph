# Определяем, запущено ли на Windows
IS_WINDOWS = platform.system() == "Windows"

# Настройка логгера с поддержкой Windows
def setup_logger():
    logger = logging.getLogger("studybuddy_bot")
    logger.setLevel(logging.INFO)
    
    # Форматтер
    formatter = logging.Formatter(
        '%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    
    # Консольный обработчик
    console_handler = logging.StreamHandler()
    console_handler.setFormatter(formatter)
    
    # Файловый обработчик с UTF-8 для Windows
    file_handler = logging.FileHandler(
        "bot.log", 
        encoding='utf-8' if IS_WINDOWS else None
    )
    file_handler.setFormatter(formatter)
    
    # Добавляем обработчики
    logger.addHandler(console_handler)
    logger.addHandler(file_handler)
    
    # Обертка для Windows
    if IS_WINDOWS:
        return WindowsSafeLogger(logger)
    return logger

class WindowsSafeLogger:
    """Обертка для логгера, которая заменяет эмодзи на Windows"""
    def __init__(self, logger):
        self.logger = logger
        self.emoji_map = {
            '✅': '[OK]', '❌': '[ERROR]', '🔥': '[STREAK]',
            '🔄': '[RELOAD]', '🌙': '[NIGHT]', '💡': '[TIP]',
            '🐾': '[PET]', '💰': '[COINS]', '⏱️': '[TIMER]',
            '📊': '[STATS]', '⚠️': '[WARN]', '🔍': '[SEARCH]',
            '🎉': '[CELEBRATE]', '💎': '[PREMIUM]'
        }
    
    def _replace_emojis(self, message):
        """Заменяет эмодзи на текстовые аналоги для Windows"""
        if not IS_WINDOWS:
            return message
        
        for emoji, text in self.emoji_map.items():
            message = message.replace(emoji, text)
        return message
    
    # Реализация всех методов логгера
    def debug(self, msg, *args, **kwargs):
        self.logger.debug(self._replace_emojis(msg), *args, **kwargs)
    
    def info(self, msg, *args, **kwargs):
        self.logger.info(self._replace_emojis(msg), *args, **kwargs)
    
    def warning(self, msg, *args, **kwargs):
        self.logger.warning(self._replace_emojis(msg), *args, **kwargs)
    
    def error(self, msg, *args, **kwargs):
        self.logger.error(self._replace_emojis(msg), *args, **kwargs)
    
    def critical(self, msg, *args, **kwargs):
        self.logger.critical(self._replace_emojis(msg), *args, **kwargs)

# Создаем логгер
logger = setup_logger()

