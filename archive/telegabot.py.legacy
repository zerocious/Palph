def get_pet_emotion(streak):
    """Возвращает эмодзи питомца в зависимости от стрика"""
    if streak == 0:
        return "грустный 😢 (начни учиться сегодня!)"
    elif streak < 3:
        return "радостный 😊 (так держать!)"
    elif streak < 7:
        return "очень счастливый 🤗 (ты молодец!)"
    else:
        return "легендарный 🌟 (ты чемпион!)"

# Обработчик кнопки "Посмотреть достижения"
@router.callback_query(F.data.startswith("show_achievements:"))
async def show_achievements(callback: types.CallbackQuery):
    # Парсим данные: "show_achievements:user_id:page"
    parts = callback.data.split(":")
    user_id = parts[1]
    page = int(parts[2]) if len(parts) > 2 else 1
    
    # Загружаем все достижения
    try:
        with open("achievements.json", "r", encoding="utf-8") as f:
            all_achievements = json.load(f)
    except Exception as e:
        await callback.answer(f"Ошибка загрузки: {str(e)}", show_alert=True)
        return
    
    # Читаем прогресс пользователя
    sheet = get_sheet()
    cell = sheet.find(str(user_id), in_column=1)
    if not cell:
        await callback.answer("Пользователь не найден", show_alert=True)
        return
    
    row = sheet.row_values(cell.row)
    achievements_raw = row[9] if len(row) > 9 else ""
    user_achievements = {}
    if achievements_raw:
        try:
            user_achievements = json.loads(achievements_raw)
        except:
            pass
    
    # Фильтруем достижения по странице
    page_achievements = {
        k: v for k, v in all_achievements.items() 
        if v.get("page", 1) == page
    }
    
    # Формируем текст для текущей страницы
    text = f"🏆 Достижения (страница {page}/3)\n\n"
    
    for ach_id, ach_data in page_achievements.items():
        ach_name = ach_data["name"]
        ach_desc = ach_data["description"]
        ach_reward = ach_data["reward"]
        ach_icon = ach_data["icon"]
        
        status = user_achievements.get(ach_id)
        
        if status == True:
            text += f"✅ {ach_icon} {ach_name}\n   {ach_desc}\n   🪙 +{ach_reward} — ПОЛУЧЕНО!\n\n"
        elif isinstance(status, dict):
            progress = status.get("progress", 0)
            target = status.get("target", 0)
            text += f"⏳ {ach_icon} {ach_name}\n   {ach_desc}\n   🪙 +{ach_reward} — {progress}/{target}\n\n"
        else:
            text += f"🔒 {ach_icon} {ach_name}\n   {ach_desc}\n   🪙 +{ach_reward} — ЗАБЛОКИРОВАНО\n\n"
    
    # Создаём кнопки навигации
    keyboard = InlineKeyboardBuilder()
    
    # Добавляем кнопки для других страниц
    for p in range(1, 4):
        if p != page:
            keyboard.button(text=str(p), callback_data=f"show_achievements:{user_id}:{p}")
    
    # Кнопка возврата в профиль
    keyboard.button(text="◀️ Профиль", callback_data=f"back_to_profile:{callback.from_user.id}")
    
    keyboard.adjust(2, 1)
    
    # Отправляем/редактируем сообщение
    try:
        await callback.message.edit_text(
            text,
            reply_markup=keyboard.as_markup()
        )
    except:
        await callback.message.answer(
            text,
            reply_markup=keyboard.as_markup()
        )
        try:
            await callback.message.delete()
        except:
            pass
    
    await callback.answer()





