@router.message(F.text == "⏱️ Стандартный таймер (25 мин)")
async def handle_standard_timer(message: Message, state: FSMContext):
    user_id = str(message.from_user.id)
    if not user_exists(user_id):
        add_user(user_id)
    
    # Проверяем, не запущен ли уже таймер
    current_state = await state.get_state()
    if current_state == TimerStates.active.state:
        data = await state.get_data()
        start_time = data.get("start_time")
        duration = data.get("duration", 25)
        elapsed = (datetime.now() - start_time).total_seconds() / 60
        remaining = max(0, duration - elapsed)
        
        await message.answer(
            f"⏱️ Таймер уже запущен!\n"
            f"Тип: Стандартный ({duration} мин)\n"
            f"Прошло: {elapsed:.0f} мин из {duration}\n"
            f"Осталось: {remaining:.0f} минут\n\n"
            f"Что хочешь сделать?",
            reply_markup=get_timer_active_keyboard()
        )
        return
    
    # Запускаем новый таймер
    duration = 25
    await state.set_state(TimerStates.active)
    await state.update_data(
        type="standard",
        duration=duration,
        start_time=datetime.now()
    )
    
    await message.answer(
        f"⏱️ Таймер запущен на {duration} минут!\n"
        f"Ваш питомец ждёт вашего возвращения 🐾",
        reply_markup=get_timer_active_keyboard()
    )
    
    # Запускаем фоновую задачу (НЕ блокирует бота)
    asyncio.create_task(run_timer_task(message.chat.id, state, user_id, duration))

# Состояния для мастера настройки
class SetupStates(StatesGroup):
    choosing_path = State()      # Выбор: настроить сейчас или позже
    setting_morning = State()    # Настройка утреннего времени
    setting_evening = State()    # Настройка вечернего времени
    confirming = State()         # Подтверждение настроек

# Обработчик /start
@router.message(Command("start"))
async def cmd_start(message: Message, state: FSMContext):
    user_id = str(message.from_user.id)
    
    # Проверяем, существует ли пользователь
    if user_exists(user_id):
        # Пользователь уже зарегистрирован — показываем профиль
        user_data = get_user_data(user_id)
        total_sessions = user_data.get("total_sessions", 0)
        total_coins = user_data.get("total_coins", 0)
        current_streak = user_data.get("current_streak", 0)
        
        # Создаём инлайн-кнопки для профиля
        inline_kb = InlineKeyboardBuilder()
        inline_kb.add(InlineKeyboardButton(text="🏆 Достижения", callback_data=f"show_achievements:{user_id}:1"))
        inline_kb.add(InlineKeyboardButton(text="📅 Ежедневные задачи", callback_data="daily_tasks"))
        inline_kb.adjust(2)
        
        await message.answer(
            f"😊 С возвращением! Твой питомец скучал!\n\n"
            f"📊 Твоя статистика:\n"
            f"• Всего сессий: {total_sessions}\n"
            f"• Всего монет: {total_coins} 🪙\n"
            f"• Твой стрик: {current_streak} дней подряд 🔥\n\n"
            f"Чем займёмся сегодня?",
            reply_markup=inline_kb.as_markup()
        )
        return
    
    # Новый пользователь — показываем выбор пути
    keyboard = ReplyKeyboardBuilder()
    keyboard.button(text="🔧 Настроить сейчас")
    keyboard.button(text="🚀 Начать сразу")
    keyboard.adjust(1)
    
    await message.answer(
        "🐾 Привет! Я — StudyBuddy, твой цифровой питомец для учёбы!\n\n"
        "✨ Я помогу тебе учиться регулярно и без стресса. "
        "Даже 5 минут в день — это уже победа!\n\n"
        "Хочешь сначала настроить уведомления под себя или начать сразу?",
        reply_markup=keyboard.as_markup(resize_keyboard=True)
    )
    await state.set_state(SetupStates.choosing_path)
    
# Запускаем таймер в фоне
    try:
        await asyncio.sleep(duration * 60)  # 25 минут в секундах
        
        # Проверяем, не отменил ли пользователь таймер
        current_state = await state.get_state()
        if current_state == TimerStates.active.state:
            # Начисляем монеты
            earned_achievements, bonus_coins, _ = add_study_session(user_id, duration_minutes=duration)
            if earned_achievements:
                await send_achievement_notification(user_id, earned_achievements)
            user_data = get_user_data(user_id)
            
            await message.answer(
                f"🎉 Отлично! Таймер завершён!\n"
                f"🪙 Получено: {duration} монет\n"
                f"📊 Всего монет: {user_data.get('total_coins', 0)}\n\n"
                f"⏱️ Теперь возьми перерыв на 5 минут для восстановления концентрации🙃",
                reply_markup=get_main_keyboard()
            )
            await state.clear()
    except asyncio.CancelledError:
        pass
# Обработчик выбора пути
@router.message(SetupStates.choosing_path, F.text.in_(["🔧 Настроить сейчас", "🚀 Начать сразу"]))
