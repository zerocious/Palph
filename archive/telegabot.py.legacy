async def handle_unexpected_input(message: Message, state: FSMContext):
    current_state = await state.get_state()
    
    if current_state == SetupStates.choosing_path.state:
        await message.answer(
            "⚠️ Выбери один из вариантов ниже:",
            reply_markup=ReplyKeyboardBuilder()
                .button(text="🔧 Настроить сейчас")
                .button(text="🚀 Начать сразу")
                .adjust(1)
                .as_markup(resize_keyboard=True)
        )
    elif current_state in [SetupStates.setting_morning.state, SetupStates.setting_evening.state]:
        await message.answer("⚠️ Выбери время из предложенных кнопок")
    else:
        await message.answer("⚠️ Используй кнопки для настройки")

async def send_achievement_notification(user_id: str, achievement_ids: list):
    """
    Отправляет уведомление о получении достижения(й) с проверкой настроек
    """
    # Проверяем, включены ли уведомления о достижениях
    sheet = get_sheet()
    cell = sheet.find(str(user_id), in_column=1)
    
    if not cell:
        return
    
    row = sheet.row_values(cell.row)
    
    # Безопасное чтение колонки K
    notification_settings_raw = row[10] if len(row) > 10 else ""
    notification_settings = {}
    
    if notification_settings_raw:
        try:
            notification_settings = json.loads(notification_settings_raw)
        except:
            pass
    
    # Проверяем флаг уведомлений о достижениях (по умолчанию включено)
    if not notification_settings.get("notification_achievements_enabled", True):
        logger.info(f"Уведомления о достижениях отключены для пользователя {user_id}")
        return
    
    # Загружаем данные достижений
    try:
        with open("achievements.json", "r", encoding="utf-8") as f:
            all_achievements = json.load(f)
    except Exception as e:
        logger.error(f"Ошибка загрузки achievements.json: {e}")
        return
    
    # Формируем сообщение
    if len(achievement_ids) == 1:
        ach_id = achievement_ids[0]
        ach = all_achievements.get(ach_id, {})
        message_text = (
            f"🎉 ПОЗДРАВЛЯЕМ! Ты получил(а) новое достижение:\n\n"
            f"{ach.get('icon', '🏆')} {ach.get('name', 'Достижение')}\n"
            f"{ach.get('description', '')}\n\n"
            f"🪙 Бонус: +{ach.get('reward', 0)} монет\n"
            f"🐾 Твой питомец гордится тобой!"
        )
    else:
        # Несколько достижений за одну сессию (редкий случай)
        achievements_list = []
        total_reward = 0
        for ach_id in achievement_ids:
            ach = all_achievements.get(ach_id, {})
            achievements_list.append(f"{ach.get('icon', '🏆')} {ach.get('name', 'Достижение')} (+{ach.get('reward', 0)} монет)")
            total_reward += ach.get('reward', 0)
        
        message_text = (
            f"🎊 ВАУ! Ты получил(а) несколько достижений за одну сессию:\n\n"
            + "\n".join(achievements_list) + f"\n\n"
            f"🪙 Общий бонус: +{total_reward} монет\n"
            f"🔥 Ты настоящий чемпион учёбы!"
        )
    
    # Отправляем уведомление
    try:
        await bot.send_message(
            chat_id=int(user_id),
            text=message_text,
            parse_mode="HTML"
        )
        logger.info(f"Уведомление о достижении отправлено пользователю {user_id}: {achievement_ids}")
    except Exception as e:
        logger.error(f"Ошибка отправки уведомления о достижении {user_id}: {e}")
        
# Обработчик отмены таймера
@router.message(TimerStates.active, F.text == "⏹️ Остановить")
async def handle_stop_timer(message: Message, state: FSMContext):
    data = await state.get_data()
    duration = data.get("duration", 25)
    start_time = data.get("start_time")
    elapsed = (datetime.now() - start_time).total_seconds() / 60
    actual_duration = min(int(elapsed), duration)
    
    user_id = str(message.from_user.id)
    earned_achievements, bonus_coins, current_streak = add_study_session(
        user_id, 
        duration_minutes=actual_duration
    )
    user_data = get_user_data(user_id)
    
    response = (
        f"⏹️ Таймер остановлен!\n"
        f"⏱️ Фактическая сессия: {actual_duration} минут\n"
        f"🪙 Получено: {actual_duration} монет"
    )
    if bonus_coins > 0:
        response += f"\n✨ Бонус за достижения: +{bonus_coins} монет"
    response += f"\n📊 Всего монет: {user_data.get('total_coins', 0)}"
    
    await message.answer(response, reply_markup=get_main_keyboard())
    await state.clear()  # Очищаем состояние — таймер завершён
    
    # Отправляем уведомления о достижениях
    if earned_achievements:
        await send_achievement_notification(user_id, earned_achievements)
    
# Кастомный таймер - начало
@router.message(F.text == "⏱️ Кастомный таймер")
async def handle_custom_timer_start(message: Message, state: FSMContext):
    # Проверяем активный таймер
    current_state = await state.get_state()
    if current_state == TimerStates.active.state:
        data = await state.get_data()
        start_time = data.get("start_time")
        duration = data.get("duration", 25)
        elapsed = (datetime.now() - start_time).total_seconds() / 60
        remaining = max(0, duration - elapsed)
        
        await message.answer(
            f"⏱️ Таймер уже запущен!\n"
            f"Тип: Кастомный ({duration} мин)\n"
            f"Прошло: {elapsed:.0f} мин из {duration}\n"
            f"Осталось: {remaining:.0f} минут\n\n",
            reply_markup=get_timer_active_keyboard()
        )
        return
    
    await message.answer(
        "🔢 Сколько минут ты хочешь учиться?\n"
        "Введите число от 5 до 120:"
    )
    await state.set_state(TimerStates.waiting_for_duration)

# Обработчик ввода длительности кастомного таймера
@router.message(TimerStates.waiting_for_duration)
async def process_duration(message: Message, state: FSMContext):
    clean_text = ''.join(filter(str.isdigit, message.text))
    
    if not clean_text:
        await message.answer("❌ Пожалуйста, введите число от 5 до 120:")
        return
    
    duration = int(clean_text)
    
    if duration < 5:
        await message.answer("⚠️ Минимум 5 минут. Попробуйте ещё раз:")
        return
    if duration > 120:
        await message.answer("⚠️ Максимум 120 минут. Попробуйте ещё раз:")
        return
    
    user_id = str(message.from_user.id)
    if not user_exists(user_id):
        add_user(user_id)
    
    # Запускаем таймер
    await state.set_state(TimerStates.active)
    await state.update_data(
        type="custom",
        duration=duration,
        start_time=datetime.now()
    )
    
    await message.answer(
        f"⏱️ Таймер запущен на {duration} минут!\n"
        f"Ваш питомец ждёт вашего возвращения 🐾",
        reply_markup=get_timer_active_keyboard()
    )
    
    # Запускаем фоновую задачу
    asyncio.create_task(run_timer_task(message.chat.id, state, user_id, duration))

# Фоновая задача таймера (НЕ блокирует бота)
async def run_timer_task(chat_id: int, state: FSMContext, user_id: str, duration: int):
    """Фоновая задача таймера — работает параллельно с квизами"""
    try:
        await asyncio.sleep(duration * 60)
        
        # Проверяем, всё ещё активен ли таймер
        current_state = await state.get_state()
        if current_state == TimerStates.active.state:
            data = await state.get_data()
            actual_duration = duration  # Полная длительность
            
            # Сохраняем сессию
            earned_achievements, bonus_coins, current_streak = add_study_session(
                user_id, 
                duration_minutes=actual_duration
            )
            user_data = get_user_data(user_id)
            
            # Формируем ответ
            response = (
                f"🎉 Таймер завершён!\n"
                f"⏱️ Сессия: {actual_duration} минут\n"
                f"🪙 Получено: {actual_duration} монет"
            )
            if bonus_coins > 0:
                response += f"\n✨ Бонус за достижения: +{bonus_coins} монет"
            response += f"\n📊 Всего монет: {user_data.get('total_coins', 0)}"
            
            # Отправляем уведомление
            try:
                await bot.send_message(
                    chat_id=chat_id,
                    text=response,
                    reply_markup=get_main_keyboard()
                )
                
                # Отправляем уведомления о достижениях
                if earned_achievements:
                    await send_achievement_notification(user_id, earned_achievements)
                    
            except Exception as e:
                logger.error(f"Ошибка отправки завершения таймера: {e}")
            
            await state.clear()
            
    except asyncio.CancelledError:
        # Таймер был остановлен вручную — ничего не делаем
        pass


