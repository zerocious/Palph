# Загрузка админов
def load_admins():
    if os.path.exists(ADMINS_FILE):
        try:
            with open(ADMINS_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                return set(data.get("admins", []))
        except Exception as e:
            logger.error(f"Ошибка чтения {ADMINS_FILE}: {e}")
    return set()

ADMINS = load_admins()
