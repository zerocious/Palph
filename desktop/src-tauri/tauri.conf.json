{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palph",
  "version": "0.1.0",
  "identifier": "app.palph.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Palph",
        "width": 420,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Учебный компаньон Palph",
    "longDescription": "Pomodoro-таймер, монеты, стрик и питомец Palph на одном аккаунте с Telegram-ботом."
  },
  "plugins": {}
}
